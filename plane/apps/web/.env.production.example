# ============================================================================
# Plane web — PRODUCTION template. Copy to `.env.production` on the build host.
# `.env.production` is git-ignored: it holds deployment secrets and must be
# provisioned by the operator (CI secret store / server file), never committed.
# ============================================================================

VITE_API_BASE_URL=""
VITE_ROUTER_BASENAME="/plane"
VITE_APP_ENV="production"

VITE_WEB_BASE_URL="https://<your-domain>"
VITE_ADMIN_BASE_URL="https://<your-domain>/god-mode"
VITE_ADMIN_BASE_PATH="/god-mode"
VITE_SPACE_BASE_URL="https://<your-domain>"
VITE_SPACE_BASE_PATH="/plane/spaces"
VITE_LIVE_BASE_URL="https://<your-domain>/live"
VITE_LIVE_BASE_PATH="/live"

# ── Chain / RPC (https + wss only) ──────────────────────────────────────────
VITE_RPC_URL="https://<your-rpc-host>"
VITE_WS_URL="wss://<your-rpc-host>/ws"
VITE_CHAIN_ID="991"
VITE_CONTRACT_ADDRESS=""
VITE_REGISTRY_CONTRACT_ADDRESS=""
VITE_WORKSPACE_REGISTRY_ADDRESS=""
VITE_FIAI_TIMEOUT="60000"
VITE_CONTRACT_GAS="3000000"
# Production phải dùng chứng chỉ hợp lệ.
RPC_ALLOW_INSECURE_TLS="false"
VITE_API_PROXY_TARGET="http://127.0.0.1:8080"

# ── FIAI SDK endpoints (same origin, behind the reverse proxy) ──────────────
FIAI_BLOCKCHAIN_BRIDGE_URL="https://<your-domain>/fiai-sdk/blockchain-bridge/"
FIAI_CRYPTO_VAULT_URL="https://<your-domain>/fiai-sdk/crypto-vault/"
FIAI_FILE_PROCESSOR_URL="https://<your-domain>/fiai-sdk/file-processor/"
VITE_FIAI_BLOCKCHAIN_BRIDGE_URL="https://<your-domain>/fiai-sdk/blockchain-bridge/"
VITE_FIAI_CRYPTO_VAULT_URL="https://<your-domain>/fiai-sdk/crypto-vault/"
VITE_FIAI_FILE_PROCESSOR_URL="https://<your-domain>/fiai-sdk/file-processor/"
# Ví mở cùng origin với Plane để không bị chặn cross-origin khi ký.
VITE_URL_CONNECT_WALLET="https://<your-domain>/connectWalletWeb/"
FIAI_CONNECT_WALLET_LOAD_MODE="url"

# ── On-chain write policy ───────────────────────────────────────────────────
VITE_ONCHAIN_TASKS_ENABLED="true"
VITE_ONCHAIN_MEMBERSHIP_SYNC="true"
# Để trống = tự động (tắt ghi ngầm CID khi công việc đã được ghi on-chain),
# nhờ vậy mỗi thao tác của người dùng chỉ phát sinh đúng 1 giao dịch.
VITE_AUTO_COMMIT_ONCHAIN=""
VITE_ONCHAIN_COMMIT_DEBOUNCE_MS="90000"
VITE_ONCHAIN_COMMIT_MIN_INTERVAL_MS="120000"
VITE_ONCHAIN_COMMIT_RETRY_MS="30000"
VITE_ONCHAIN_COMMIT_MAX_ATTEMPTS="5"

# ── IPFS ────────────────────────────────────────────────────────────────────
VITE_PINATA_PROXY_URL="https://<your-ipfs-proxy>"
VITE_IPFS_GATEWAYS="https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/"

VITE_DEFAULT_WORKSPACE_SLUG="fiai"
VITE_DEFAULT_WORKSPACE_NAME="FIAI"

# ── Email (Brevo) ───────────────────────────────────────────────────────────
# Đặt VITE_MAIL_PROXY_URL để API key nằm ở server, KHÔNG nhúng vào bundle.
VITE_MAIL_PROXY_URL="https://<your-domain>/mail/relay"
VITE_BREVO_API_KEY=""
VITE_EMAIL_SENDER_NAME="Plane Workspace"
VITE_EMAIL_SENDER_ADDRESS=""

# ── Signing key ─────────────────────────────────────────────────────────────
# Production KHÔNG được đặt khoá ký trong biến VITE_* (bundle công khai).
VITE_BLS_PRIVATE_KEY=""

# ── Static asset pass-through (server-side only; do not prefix with VITE_) ──
VITE_STATIC_PASS=""

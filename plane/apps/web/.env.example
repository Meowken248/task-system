# ============================================================================
# Plane web — template. Copy to `.env` (local) or `.env.production` (deploy).
# NEVER commit a real `.env*` file: they contain secrets (mail API key, signing
# key, private RPC endpoint). Only this template is tracked by git.
# ============================================================================

VITE_API_BASE_URL=""
VITE_ROUTER_BASENAME="/plane"

VITE_WEB_BASE_URL="http://localhost:3000"

VITE_ADMIN_BASE_URL="http://localhost:3001"
VITE_ADMIN_BASE_PATH="/god-mode"

VITE_SPACE_BASE_URL="http://localhost:3002"
VITE_SPACE_BASE_PATH="/spaces"

VITE_LIVE_BASE_URL="http://localhost:3100"
VITE_LIVE_BASE_PATH="/live"

# ── Chain / RPC ─────────────────────────────────────────────────────────────
# Dùng https/wss khi không còn trong LAN. http/wss lẫn lộn gây đọc dữ liệu lỗi
# và làm giao dịch bị báo "chưa xác nhận" dù đã lên chain.
VITE_RPC_URL="http://127.0.0.1:8747"
VITE_WS_URL="ws://127.0.0.1:8747/ws"
VITE_CHAIN_ID="991"
VITE_CONTRACT_ADDRESS=""
VITE_REGISTRY_CONTRACT_ADDRESS=""
VITE_WORKSPACE_REGISTRY_ADDRESS=""
VITE_CONTRACT_GAS="3000000"
VITE_FIAI_TIMEOUT="60000"
# Máy nội bộ dùng chứng chỉ tự ký → chỉ bật true trong LAN, KHÔNG bật ở production.
RPC_ALLOW_INSECURE_TLS="false"
VITE_API_PROXY_TARGET="http://127.0.0.1:8080"

# ── FIAI SDK endpoints ──────────────────────────────────────────────────────
VITE_URL_CONNECT_WALLET="http://localhost:6005"
VITE_FIAI_BLOCKCHAIN_BRIDGE_URL="http://localhost:6001/"
VITE_FIAI_CRYPTO_VAULT_URL="http://localhost:6002/"
VITE_FIAI_FILE_PROCESSOR_URL="http://localhost:6003/"
VITE_MOCK_FIAI="false"

# ── On-chain write policy ───────────────────────────────────────────────────
# Bật ghi công việc on-chain (createTask/updateTask/...). Mỗi thao tác = 1 giao dịch.
VITE_ONCHAIN_TASKS_ENABLED="true"
# Đồng bộ thành viên workspace lên registry on-chain.
VITE_ONCHAIN_MEMBERSHIP_SYNC="true"
# Ghi ngầm "con trỏ dữ liệu" (CID) sau mỗi lần lưu — chỉ là bản sao lưu.
#   "" (mặc định) → tự quyết định: BẬT khi VITE_ONCHAIN_TASKS_ENABLED=false,
#                   TẮT khi công việc đã được ghi on-chain (tránh 1 thao tác = 2 giao dịch).
#   "true"        → luôn ghi ngầm (gộp theo các biến VITE_ONCHAIN_COMMIT_* bên dưới).
#   "false"       → chỉ ghi khi người dùng bấm "Đồng bộ".
VITE_AUTO_COMMIT_ONCHAIN=""
# Gộp các lần lưu liên tiếp thành 1 giao dịch và giữ khoảng cách tối thiểu.
VITE_ONCHAIN_COMMIT_DEBOUNCE_MS="90000"
VITE_ONCHAIN_COMMIT_MIN_INTERVAL_MS="120000"
VITE_ONCHAIN_COMMIT_RETRY_MS="30000"
VITE_ONCHAIN_COMMIT_MAX_ATTEMPTS="5"

# ── IPFS ────────────────────────────────────────────────────────────────────
VITE_PINATA_PROXY_URL=""
VITE_IPFS_GATEWAYS="https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/"
# Storage attempts are bounded; signed transactions are not retried by this policy.
VITE_IPFS_UPLOAD_TIMEOUT_MS="45000"
VITE_IPFS_UPLOAD_TOTAL_TIMEOUT_MS="90000"
VITE_IPFS_UPLOAD_MAX_ATTEMPTS="2"
VITE_IPFS_UPLOAD_RETRY_DELAY_MS="1000"
VITE_IPFS_BACKGROUND_RETRY_MS="30000"

VITE_DEFAULT_WORKSPACE_SLUG="fiai"
VITE_DEFAULT_WORKSPACE_NAME="FIAI"

# ── Email (Brevo) ───────────────────────────────────────────────────────────
# Ưu tiên VITE_MAIL_PROXY_URL: một relay phía server giữ API key, nhờ vậy khoá
# không bao giờ đi vào bundle trình duyệt. VITE_BREVO_API_KEY chỉ dùng cho máy
# local và phải để trống khi commit.
VITE_MAIL_PROXY_URL=""
VITE_BREVO_API_KEY=""
VITE_EMAIL_SENDER_NAME="Plane Workspace"
VITE_EMAIL_SENDER_ADDRESS=""

# ── Signing key (CHỈ cho môi trường phát triển) ─────────────────────────────
# Khoá BLS dùng khi contract yêu cầu chữ ký BLS. Mọi biến VITE_* đều nằm trong
# bundle tải về trình duyệt ⇒ KHÔNG đặt khoá thật ở production.
# Production: để trống và cấu hình khoá phía ví/dịch vụ ký.
VITE_BLS_PRIVATE_KEY=""
